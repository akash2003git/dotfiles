{
  "custom/hyprsunset": {
    "return-type": "json",
    "format": "{0} ",
    "exec": "$HOME/.config/waybar/scripts/hyprsunset -rq",
    "rotate": 0,
    "on-click": "$HOME/.config/waybar/scripts/hyprsunset -t -P waybar:19",
    "on-scroll-up": "$HOME/.config/waybar/scripts/hyprsunset -i '' -P waybar:19",
    "on-scroll-down": "$HOME/.config/waybar/scripts/hyprsunset -d '' -P waybar:19",
    "interval": "once",
    "tooltip": true,
    "signal": 19,
    "menu": "on-click-right",
    "menu-file": "$HOME/.config/waybar/menus/hyprsunset.xml",
    "menu-actions": {
      "warm-candle": "$HOME/.config/waybar/scripts/hyprsunset --cm temp -s 3000 -P waybar:19",
      "soft-warm": "$HOME/.config/waybar/scripts/hyprsunset --cm temp -s 4000 -P waybar:19",
      "neutral-white": "$HOME/.config/waybar/scripts/hyprsunset --cm temp -s 5000 -P waybar:19",
      "daylight": "$HOME/.config/waybar/scripts/hyprsunset --cm temp -s 6500 -P waybar:19",
      "cool-white": "$HOME/.config/waybar/scripts/hyprsunset --cm temp -s 7500 -P waybar:19",
      "bright-blue": "$HOME/.config/waybar/scripts/hyprsunset --cm temp -s 9000 -P waybar:19",
      "arctic-blue": "$HOME/.config/waybar/scripts/hyprsunset --cm temp -s 10000 -P waybar:19",
      "gamma-20": "$HOME/.config/waybar/scripts/hyprsunset --cm gamma -s 20 -P waybar:19",
      "gamma-30": "$HOME/.config/waybar/scripts/hyprsunset --cm gamma -s 30 -P waybar:19",
      "gamma-40": "$HOME/.config/waybar/scripts/hyprsunset --cm gamma -s 40 -P waybar:19",
      "gamma-50": "$HOME/.config/waybar/scripts/hyprsunset --cm gamma -s 50 -P waybar:19",
      "gamma-60": "$HOME/.config/waybar/scripts/hyprsunset --cm gamma -s 60 -P waybar:19",
      "gamma-70": "$HOME/.config/waybar/scripts/hyprsunset --cm gamma -s 70 -P waybar:19",
      "gamma-80": "$HOME/.config/waybar/scripts/hyprsunset --cm gamma -s 80 -P waybar:19",
      "gamma-90": "$HOME/.config/waybar/scripts/hyprsunset --cm gamma -s 90 -P waybar:19",
      "gamma-100": "$HOME/.config/waybar/scripts/hyprsunset --cm gamma -s 100 -P waybar:19"
    }
  }
}
