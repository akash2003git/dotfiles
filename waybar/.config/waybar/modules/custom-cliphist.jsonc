{
    "custom/cliphist": {
        "format": "{0} ",
        "rotate": 0,
        "tooltip-format": "\udb80\udd47 Clipboard history",
        "on-click": "sleep 0.1 && $HOME/.config/waybar/scripts/cliphist -c",
        "menu": "on-click-right",
        "menu-file": "$HOME/.config/waybar/menus/clipboard.xml",
        "menu-actions": {
            "favorites": "$HOME/.config/waybar/scripts/cliphist --favorites",
            "history": "$HOME/.config/waybar/scripts/cliphist --copy",
            "delete-history": "$HOME/.config/waybar/scripts/cliphist --delete",
            "manage-favorites": "$HOME/.config/waybar/scripts/cliphist 'Manage Favorites'",
            "clear-history": "$HOME/.config/waybar/scripts/cliphist --wipe"
        },
        "interval": 86400,
        "tooltip": true
    }
}