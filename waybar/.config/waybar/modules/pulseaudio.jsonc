{
  "pulseaudio": {
    "format": "{icon} {volume}",
    "rotate": 0,
    "format-muted": "",
    "on-click": "pavucontrol-qt -t 3 || pavucontrol -t 3",
    "on-click-right": "$HOME/.config/waybar/scripts/volumecontrol -s ''",
    "on-click-middle": "$HOME/.config/waybar/scripts/volumecontrol -o m",
    "on-scroll-up": "$HOME/.config/waybar/scripts/volumecontrol -o i",
    "on-scroll-down": "$HOME/.config/waybar/scripts/volumecontrol -o d",
    "tooltip-format": "{icon} {desc} // {volume}%",
    "scroll-step": 5,
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "",
        "",
        ""
      ]
    }
  }
}
