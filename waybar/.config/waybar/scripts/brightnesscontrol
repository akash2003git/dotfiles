#!/usr/bin/env bash
# Standalone backlight controller (HyDE-free replacement for `hyde-shell brightnesscontrol`)
# Usage: brightnesscontrol <i|d> [step%]

if ! command -v brightnessctl >/dev/null 2>&1; then
    notify-send "Brightness" "brightnessctl is not installed"
    exit 1
fi

step="${BRIGHTNESS_STEPS:-5}"
[ -n "$2" ] && step="$2"
get_brightness() { brightnessctl -m | grep -o '[0-9]\+%' | head -c-2; }

case "$1" in
i | -i)
    if [ "$(get_brightness)" -lt 10 ]; then step=1; fi
    brightnessctl set +"$step"% >/dev/null
    ;;
d | -d)
    if [ "$(get_brightness)" -le 1 ]; then
        brightnessctl set "$step"% >/dev/null
    else
        [ "$(get_brightness)" -le 10 ] && step=1
        brightnessctl set "$step"%- >/dev/null
    fi
    ;;
*)
    echo "Usage: $(basename "$0") <i|d> [step%]" >&2
    exit 1
    ;;
esac

b=$(get_brightness)
notify-send -a "Waybar" -r 7 -t 800 "Brightness: ${b}%"
